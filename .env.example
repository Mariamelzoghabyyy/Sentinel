# Sentinel configuration — copy to .env or export in your shell.
# ALL of these are optional: with none set, Sentinel runs fully offline
# using its deterministic agents and produces the same report structure.

# --- LLM backend (first match wins; set SENTINEL_BACKEND to force one) ------
# SENTINEL_BACKEND=groq

# Groq (fast + free tier, good default for log triage)
# GROQ_API_KEY=gsk_...
# SENTINEL_MODEL=llama-3.3-70b-versatile

# OpenAI, or anything OpenAI-compatible (OpenRouter, Together, vLLM, LM Studio)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# SENTINEL_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# SENTINEL_MODEL=claude-3-5-haiku-latest

# Local Ollama (no data leaves the host — the right choice for real logs)
# OLLAMA_HOST=http://localhost:11434
# SENTINEL_MODEL=llama3.1

# --- Behaviour --------------------------------------------------------------
# Auto-approve containment proposals (DEMO ONLY — never in production)
# SENTINEL_AUTO_APPROVE=false
